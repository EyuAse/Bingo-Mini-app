# ==============================================================
# Lomi Bingo Mini-App Environment Configuration (.env)
# Place this file in the project root directory
# ==============================================================

# [CRITICAL] Neon PostgreSQL Connection String (Required for backend & DB operations)
# You can copy this from your Render dashboard or Neon console (https://console.neon.tech)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Security & Authentication
ADMIN_PIN=1234
JWT_SECRET=lomi_bingo_super_secret_production_key_2026_et

# Telegram Bot Integration (Optional in .env if configured in Admin Desk DB)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=
TELEGRAM_CHANNEL_ID=

# [OPTIONAL FRONTEND OVERRIDE]
# If you run the frontend locally and want to connect to the live Render backend:
# VITE_BACKEND_URL=https://bingo-mini-app-30pe.onrender.com
